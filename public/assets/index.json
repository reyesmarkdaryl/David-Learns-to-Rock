{
  "metadata": {
    "assetPack": "Tiny Swords",
    "version": "1.2",
    "description": "Canonical index for Tiny Swords asset pack used in Phaser 4 Horde Survivor"
  },
  "units": {
    "teams": ["Black", "Blue", "Purple", "Red", "Yellow"],
    "types": {
      "warrior": {
        "sprites": ["Warrior_Idle.png", "Warrior_Run.png", "Warrior_Attack1.png", "Warrior_Attack2.png", "Warrior_Guard.png"],
        "animations": {
          "idle": { "frame": "Warrior_Idle.png" },
          "run": { "frame": "Warrior_Run.png" },
          "attack": { "frames": ["Warrior_Attack1.png", "Warrior_Attack2.png"] }
        }
      },
      "archer": {
        "sprites": ["Archer_Idle.png", "Archer_Run.png", "Archer_Shoot.png", "Arrow.png"],
        "animations": {
          "idle": { "frame": "Archer_Idle.png" },
          "run": { "frame": "Archer_Run.png" },
          "shoot": { "frame": "Archer_Shoot.png" }
        }
      },
      "lancer": {
        "sprites": [
          "Lancer_Idle.png",
          "Lancer_Run.png",
          "Lancer_Up_Attack.png",
          "Lancer_Down_Attack.png",
          "Lancer_Right_Attack.png",
          "Lancer_UpRight_Attack.png",
          "Lancer_DownRight_Attack.png"
        ]
      },
      "monk": {
        "sprites": ["Idle.png", "Run.png", "Heal.png", "Heal_Effect.png"]
      },
      "pawn": {
        "sprites": ["Pawn_Idle.png", "Pawn_Run.png"],
        "variants": ["Axe", "Gold", "Hammer", "Knife", "Meat", "Pickaxe", "Wood"]
      }
    },
    "path": "public/assets/tinysword/Units/{Team} Units/"
  },
  "tilemaps": {
    "basePath": "public/assets/tilemaps/",
    "clutter": {
      "path": "public/assets/tilemaps/clutter/",
      "files": ["Objects.png", "Objects_animated.png", "Objects_animated2.png", "Objects_animated3.png", "details.png"]
    },
    "map": {
      "path": "public/assets/tilemaps/map/",
      "files": ["Ground_rocks.png", "old_dungeon.png", "walls.png", "water_coasts.png", "water_detilazation.png", "water_detilazation_v2.png"]
    },
    "objects": {
      "path": "public/assets/tilemaps/PNG/Objects_separately/",
      "description": "Individual object sprites for the room editor"
    },
    "tiled": {
      "path": "public/assets/tilemaps/map/",
      "files": ["Water_detilazation2.tsx"]
    }
  },
